# Model provider
OPENROUTER_API_KEY=""

# Deployment boundary. `local` preserves the CLI/development legacy scope;
# `hosted` requires a valid Theriad bearer session for private /api and /v1
# routes. Set this explicitly in the public service environment.
THERIAD_DEPLOYMENT_MODE=local
# Set these together for a hosted Postgres/Storage deployment. Hosted mode
# fails closed when the required Supabase server key or migration is missing.
THERIAD_STORAGE_BACKEND=sqlite
THERIAD_HOSTED_STORAGE_REQUIRED=false
SUPABASE_SERVICE_ROLE_KEY=""
THERIAD_SUPABASE_STORAGE_BUCKET=theriad-files
# Fernet key used to encrypt provider credentials at rest. In hosted mode,
# inject this from the deployment's managed secret store; do not commit it.
THERIAD_SECRET_ENCRYPTION_KEY=

# Theriad is currently BYOK-only. Add an OpenRouter key through Account;
# OpenRouter bills the account associated with that key directly.

# Chat internet access. The chat model gets web tools and decides itself when
# to use them: OpenRouter's web_search server tool (billed to the user's own
# OpenRouter key, ~$0.007/search on Exa), public page reads, and — when an
# OpenSandbox server is healthy — an isolated Chromium for JavaScript pages.
THERIAD_CHAT_WEB_TOOLS=true
# Seconds of tool use before the model must answer (keep under the proxy timeout).
THERIAD_CHAT_WEB_DEADLINE_SECONDS=45
# Local/dev: offer browser tools when OpenSandbox is healthy.
THERIAD_CHAT_BROWSER_TOOLS=true
# Hosted: browsing stays off unless explicitly enabled after deploying
# infra/opensandbox (service, config, egress firewall).
THERIAD_HOSTED_WEB_BROWSING=0
# Guests: platform-paid allowance, then cut off with a sign-up message.
# Unset key = guests keep free-model chat without web tools.
THERIAD_GUEST_OPENROUTER_API_KEY=
THERIAD_GUEST_ALLOWANCE_USD=1.00
THERIAD_GUEST_ALLOWANCE_PER_IP_DAILY_USD=1.00
THERIAD_GUEST_ALLOWANCE_GLOBAL_DAILY_USD=10.00
# Guests get search + page reads; the sandbox browser is opt-in for them.
THERIAD_GUEST_WEB_BROWSING=0
THERIAD_OPENSANDBOX_MAX_SESSIONS=4
THERIAD_OPENSANDBOX_CPU=1
THERIAD_OPENSANDBOX_MEMORY=1536Mi

# Legacy server-side search (used only by the deprecated agent search path).
# Start the repo-managed SearXNG service with:
#   docker compose -f docker-compose.searxng.yml up -d
# In production this must be reachable from the backend process; localhost is
# correct only when SearXNG runs on the same host/network namespace.
SEARXNG_URL="http://127.0.0.1:8081"
BRAVE_SEARCH_API_KEY=""
SCRAPLING_ENABLED=false

# Headroom context optimization. Enabled by default at the provider boundary.
# The deterministic pipeline is safe for fresh deployments; set the model to
# `default` only after warming and measuring the optional text compressor.
THERIAD_HEADROOM_ENABLED=true
THERIAD_HEADROOM_MODE=optimize
THERIAD_HEADROOM_KOMPRESS_MODEL=disabled

# Supabase Auth / Google sign-in. The publishable key is safe for browser use;
# never put a Supabase service-role key in VITE_* variables.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Preferred server-only key for shared TaskEngine persistence. The legacy
# SUPABASE_SERVICE_ROLE_KEY above is also supported; never use a VITE_ prefix.
SUPABASE_SECRET_KEY="sb_secret_..."
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Email sign-in and local-account password recovery. Theriad sends short-lived
# verification codes through this SMTP relay; leave blank only in environments
# where email sign-in and recovery are intentionally unavailable. Do not expose
# these values to the browser or use VITE_ names for them.
THERIAD_APP_URL="https://theriad.example.com"
THERIAD_SMTP_HOST="smtp.example.com"
THERIAD_SMTP_PORT=587
THERIAD_SMTP_USERNAME=""
THERIAD_SMTP_PASSWORD=""
THERIAD_SMTP_FROM="Theriad <accounts@theriad.example.com>"
THERIAD_SMTP_USE_TLS=true

# Private site-traffic dashboard owner. This must match the registered
# Theriad username that is allowed to read /api/analytics/summary.
THERIAD_ANALYTICS_OWNER_USERNAME="puranha"
# Optional recovery code for a registered account that cannot use the owner
# account. Keep this backend-only, high entropy, and out of VITE_* variables.
THERIAD_ANALYTICS_ACCESS_CODE=""

# Router eval harness (theriad/eval). Only needed to build a corpus or populate
# the outcome grid; `plan` and `report` are fully offline and need neither.
# HF_TOKEN is required for gated datasets (GPQA, HLE) — accept each dataset's
# terms on HuggingFace first, then create a read token.
HF_TOKEN=""

# Artifact-backed model selection. Keep off until a grouped, untouched-holdout
# study has produced and approved the artifact. Missing/corrupt artifacts fall
# back to the legacy router.
THERIAD_ROUTER_V2_MODE=off
THERIAD_ROUTER_V2_ARTIFACT=/absolute/path/to/router-v2.json
THERIAD_ROUTER_V2_CANARY_PCT=5
THERIAD_ROUTER_V2_SHADOW_BUDGET_FRACTION=0.05
# Heavy semantic artifacts additionally require an approved <=120 MB / <=20 ms
# runtime profile. Keep false for the dependency-light surface baseline.
THERIAD_ROUTER_V2_ENABLE_EMBEDDINGS=false
# auto mirrors normalized observations to Supabase when server credentials exist.
THERIAD_ROUTING_OBSERVATION_STORE=auto

# Unified task engine
THERIAD_TASK_STORE=auto
THERIAD_ALLOWED_WORKSPACE_ROOT=/absolute/path/to/theriad
THERIAD_TASK_EVENT_DIR=/absolute/path/to/theriad/data/agent-tasks
THERIAD_SUPERVISOR_LEASE_SECONDS=120
# Optional override; otherwise a token is generated at the file below (0600).
THERIAD_LOCAL_API_TOKEN=
THERIAD_LOCAL_API_TOKEN_FILE=~/.theriad/local-api-token

# OpenSandbox is the only browser execution backend. Its service owns the
# isolated Chromium instance; the API key is server-only and never sent to the
# browser or returned by status endpoints.
THERIAD_OPENSANDBOX_DOMAIN=127.0.0.1:8080
THERIAD_OPENSANDBOX_PROTOCOL=http
THERIAD_OPENSANDBOX_API_KEY=
THERIAD_OPENSANDBOX_BROWSER_IMAGE=opensandbox/chrome:latest
THERIAD_OPENSANDBOX_TIMEOUT_SECONDS=300
THERIAD_OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=30
THERIAD_OPENSANDBOX_CDP_READY_TIMEOUT_SECONDS=20
# Local macOS server uses host-mapped Docker bridge endpoints directly.
THERIAD_OPENSANDBOX_USE_SERVER_PROXY=false

# Hosted agents run only on separate worker capacity. The web process remains
# blocked until the remote task adapter is enabled in a reviewed release.
THERIAD_HOSTED_AGENT_ENABLED=false
THERIAD_AGENT_RUNNER_URL=""
THERIAD_AGENT_RUNNER_TOKEN=""
THERIAD_AGENT_RUNNER_WORKDIR=/var/lib/theriad-agent-tasks
THERIAD_AGENT_RUNNER_IMAGE=theriad-agent-runner:latest
